// API tests for the libharfbuzz bindings.
//
// Every test below calls into the C library, so the suite needs
// HarfBuzz installed and linked.  `novo pkg build` type-checks the
// declarations without it.  `novo test` runs them and does not.
//
// The suite carries its own font as hex.  It is a 776-byte TrueType
// font built for these tests, and it has three glyphs.  They are the
// substitute glyph, a square named "square" mapped from U+0041 and a
// triangle named "triangle" mapped from U+0042.  The font is wrapped
// in a blob from memory, so the suite reads and writes nothing.

use std.test
use libharfbuzz

// The test font, 776 bytes of TrueType.
const FONT_HEX: Str = ""

// The length of the test font in bytes.
const FONT_LEN: Int = 776

// `HB_MEMORY_MODE_DUPLICATE`: HarfBuzz copies the bytes.
const MEMORY_DUPLICATE: Int = 0

// `HB_DIRECTION_LTR`.
const DIRECTION_LTR: Int = 4

// `HB_DIRECTION_RTL`.
const DIRECTION_RTL: Int = 5

// `HB_DIRECTION_INVALID`.
const DIRECTION_INVALID: Int = 0

// `HB_SCRIPT_LATIN`, which is "Latn" read as a big-endian number.
const SCRIPT_LATIN: Int = 1281455214

// The tag "cmap", the character map table.
const TAG_CMAP: Int = 1668112752

// The scale every test below gives its font: twice the font's design
// units per em, so every advance comes back doubled.
const SCALE: Int = 2000

// The design units per em the test font declares.
const UPEM: Int = 1000

// The advance every glyph in the test font has, in design units.
const ADVANCE: Int = 700

// One record of a glyph information or glyph position array.
const GLYPH_RECORD: Int = 20

// `hb_glyph_extents_t` is four signed 32-bit values.
const EXTENTS_SIZE: Int = 16

// `hb_font_extents_t` is 48 bytes, of which the first twelve are the
// ascender, the descender and the line gap.
const FONT_EXTENTS_SIZE: Int = 48

// `hb_feature_t` is four 32-bit values: the tag, the value, the start
// and the end.
const FEATURE_SIZE: Int = 16

// The bytes of the test font, in a buffer the caller owns.
fn font_buffer() -> Int
    let buf = ptr.alloc(FONT_LEN)
    let _ = ptr.write_bytes_buf(buf, bytes.from_hex(FONT_HEX) ?? bytes.from_str(""))
    return buf

// Read the low thirty-two bits of the word at `addr`, unsigned.
fn u32_at(addr: Int) -> Int
    return ptr.read_word(addr) & 4294967295

// Read the low thirty-two bits of the word at `addr`, signed.
fn i32_at(addr: Int) -> Int
    return ptr.read_word(addr) as i32

// A font over the test font, at twice its design scale.  The caller
// releases the font and frees the buffer it is given back.
fn test_font(font_bytes: Int) -> Int [ffi]
    let blob = libharfbuzz.hb_blob_create(font_bytes, FONT_LEN, MEMORY_DUPLICATE, 0, 0)
    let face = libharfbuzz.hb_face_create(blob, 0)
    let font = libharfbuzz.hb_font_create(face)
    libharfbuzz.hb_font_set_scale(font, SCALE, SCALE)
    libharfbuzz.hb_face_destroy(face)
    libharfbuzz.hb_blob_destroy(blob)
    return font

@test
fn test_the_library_reports_its_version() [io, ffi]
    test.case("hb_version, hb_version_string")
    let major = ptr.alloc_word()
    let minor = ptr.alloc_word()
    let micro = ptr.alloc_word()
    libharfbuzz.hb_version(major, minor, micro)
    test.assert(u32_at(major) >= 2)
    test.assert(u32_at(minor) >= 0)
    test.assert(u32_at(micro) >= 0)
    test.assert(str.len(ptr.read_str(libharfbuzz.hb_version_string())) > 0)
    ptr.free(micro)
    ptr.free(minor)
    ptr.free(major)

@test
fn test_a_tag_a_direction_a_script_and_a_language_round_trip() [io, ffi]
    test.case("hb_tag_from_string, hb_tag_to_string, hb_direction_from_string, hb_direction_to_string, hb_script_from_string, hb_script_to_iso15924_tag, hb_language_from_string, hb_language_to_string, hb_language_get_default")
    test.assert(libharfbuzz.hb_tag_from_string("cmap", -1) == TAG_CMAP)
    // Four bytes are written and there is no terminator.
    let buf = ptr.alloc(8)
    libharfbuzz.hb_tag_to_string(TAG_CMAP, buf)
    test.assert(bytes.to_str(ptr.read_bytes_n(buf, 4)) == "cmap")
    // A tag shorter than four characters is padded with spaces.
    libharfbuzz.hb_tag_to_string(libharfbuzz.hb_tag_from_string("li", -1), buf)
    test.assert(bytes.to_str(ptr.read_bytes_n(buf, 4)) == "li  ")
    test.assert(libharfbuzz.hb_direction_from_string("ltr", -1) == DIRECTION_LTR)
    test.assert(libharfbuzz.hb_direction_from_string("rtl", -1) == DIRECTION_RTL)
    // A name the library does not know is the invalid direction.
    test.assert(libharfbuzz.hb_direction_from_string("sideways", -1) == DIRECTION_INVALID)
    test.assert(ptr.read_str(libharfbuzz.hb_direction_to_string(DIRECTION_LTR)) == "ltr")
    test.assert(ptr.read_str(libharfbuzz.hb_direction_to_string(DIRECTION_INVALID)) == "invalid")
    let latin = libharfbuzz.hb_script_from_string("Latn", -1)
    test.assert(latin == SCRIPT_LATIN)
    test.assert(libharfbuzz.hb_script_to_iso15924_tag(latin) == latin)
    // A language handle is interned: the same tag answers the same one.
    let english = libharfbuzz.hb_language_from_string("en", -1)
    test.assert(english != 0)
    test.assert(libharfbuzz.hb_language_from_string("en", -1) == english)
    test.assert(ptr.read_str(libharfbuzz.hb_language_to_string(english)) == "en")
    test.assert(libharfbuzz.hb_language_get_default() != 0)
    ptr.free(buf)

@test
fn test_a_blob_holds_the_bytes_it_was_given() [io, ffi]
    test.case("hb_blob_create, hb_blob_get_length, hb_blob_get_data, hb_blob_destroy, hb_blob_create_from_file_or_fail")
    let font_bytes = font_buffer()
    let blob = libharfbuzz.hb_blob_create(font_bytes, FONT_LEN, MEMORY_DUPLICATE, 0, 0)
    test.assert(blob != 0)
    test.assert(libharfbuzz.hb_blob_get_length(blob) == FONT_LEN)
    let length = ptr.alloc_word()
    let data = libharfbuzz.hb_blob_get_data(blob, length)
    test.assert(u32_at(length) == FONT_LEN)
    // Mode 0 copies, so the blob's bytes are not the caller's bytes.
    test.assert(data != font_bytes)
    test.assert(bytes.to_hex(ptr.read_bytes_n(data, 4)) == "00010000")
    libharfbuzz.hb_blob_destroy(blob)
    // A file that is not there answers 0 rather than an empty blob.
    test.assert(libharfbuzz.hb_blob_create_from_file_or_fail("/nonexistent/novo/font.ttf") == 0)
    ptr.free(length)
    ptr.free(font_bytes)

@test
fn test_a_face_reports_its_glyphs_its_scale_and_its_tables() [io, ffi]
    test.case("hb_face_count, hb_face_create, hb_face_get_glyph_count, hb_face_get_upem, hb_face_get_index, hb_face_reference_table, hb_face_get_table_tags, hb_face_destroy")
    let font_bytes = font_buffer()
    let blob = libharfbuzz.hb_blob_create(font_bytes, FONT_LEN, MEMORY_DUPLICATE, 0, 0)
    test.assert(libharfbuzz.hb_face_count(blob) == 1)
    let face = libharfbuzz.hb_face_create(blob, 0)
    test.assert(face != 0)
    test.assert(libharfbuzz.hb_face_get_glyph_count(face) == 3)
    test.assert(libharfbuzz.hb_face_get_upem(face) == UPEM)
    test.assert(libharfbuzz.hb_face_get_index(face) == 0)
    // One table as a blob of its own.
    let cmap = libharfbuzz.hb_face_reference_table(face, TAG_CMAP)
    test.assert(libharfbuzz.hb_blob_get_length(cmap) == 44)
    libharfbuzz.hb_blob_destroy(cmap)
    // A table the font does not have is the empty blob, not a 0.
    let missing = libharfbuzz.hb_face_reference_table(face, libharfbuzz.hb_tag_from_string("GSUB", -1))
    test.assert(missing != 0)
    test.assert(libharfbuzz.hb_blob_get_length(missing) == 0)
    libharfbuzz.hb_blob_destroy(missing)
    // The ten tables, written into an array of four-byte tags.
    let count = ptr.alloc_word()
    ptr.write_i32(count, 16)
    let tags = ptr.alloc(64)
    test.assert(libharfbuzz.hb_face_get_table_tags(face, 0, count, tags) == 10)
    test.assert(u32_at(count) == 10)
    let first = ptr.alloc(8)
    libharfbuzz.hb_tag_to_string(u32_at(tags), first)
    test.assert(bytes.to_str(ptr.read_bytes_n(first, 4)) == "OS/2")
    libharfbuzz.hb_face_destroy(face)
    libharfbuzz.hb_blob_destroy(blob)
    ptr.free(first)
    ptr.free(tags)
    ptr.free(count)
    ptr.free(font_bytes)

@test
fn test_a_font_carries_a_scale_and_its_face() [io, ffi]
    test.case("hb_font_create, hb_font_create_sub_font, hb_font_get_face, hb_font_set_scale, hb_font_get_scale, hb_ot_font_set_funcs, hb_font_destroy")
    let font_bytes = font_buffer()
    let blob = libharfbuzz.hb_blob_create(font_bytes, FONT_LEN, MEMORY_DUPLICATE, 0, 0)
    let face = libharfbuzz.hb_face_create(blob, 0)
    let font = libharfbuzz.hb_font_create(face)
    test.assert(libharfbuzz.hb_font_get_face(font) == face)
    let x = ptr.alloc_word()
    let y = ptr.alloc_word()
    // A font starts at the face's design units per em.
    libharfbuzz.hb_font_get_scale(font, x, y)
    test.assert(i32_at(x) == UPEM)
    test.assert(i32_at(y) == UPEM)
    libharfbuzz.hb_font_set_scale(font, SCALE, 0 - SCALE)
    libharfbuzz.hb_font_get_scale(font, x, y)
    test.assert(i32_at(x) == SCALE)
    // A negative scale mirrors the axis, and it arrives negative.
    test.assert(i32_at(y) == 0 - SCALE)
    libharfbuzz.hb_font_set_scale(font, SCALE, SCALE)
    // A font created from a face already has the OpenType functions,
    // and asking for them again is allowed.
    libharfbuzz.hb_ot_font_set_funcs(font)
    // A sub-font inherits the parent's face.
    let sub = libharfbuzz.hb_font_create_sub_font(font)
    test.assert(sub != 0)
    test.assert(libharfbuzz.hb_font_get_face(sub) == face)
    libharfbuzz.hb_font_destroy(sub)
    libharfbuzz.hb_font_destroy(font)
    libharfbuzz.hb_face_destroy(face)
    libharfbuzz.hb_blob_destroy(blob)
    ptr.free(y)
    ptr.free(x)
    ptr.free(font_bytes)

@test
fn test_a_font_answers_a_glyph_for_a_character_and_its_advances() [io, ffi]
    test.case("hb_font_get_nominal_glyph, hb_font_get_glyph_h_advance, hb_font_get_glyph_v_advance")
    let font_bytes = font_buffer()
    let font = test_font(font_bytes)
    let glyph = ptr.alloc_word()
    test.assert(libharfbuzz.hb_font_get_nominal_glyph(font, 65, glyph) == 1)
    test.assert(u32_at(glyph) == 1)
    test.assert(libharfbuzz.hb_font_get_nominal_glyph(font, 66, glyph) == 1)
    test.assert(u32_at(glyph) == 2)
    // A character the font does not cover answers 0 and writes 0.
    test.assert(libharfbuzz.hb_font_get_nominal_glyph(font, 90, glyph) == 0)
    test.assert(u32_at(glyph) == 0)
    // The scale is twice the design units, so the advance is doubled.
    let advance = libharfbuzz.hb_font_get_glyph_h_advance(font, 1) as i32
    test.assert(advance == ADVANCE * SCALE / UPEM)
    // A vertical advance is negative, and this font has no vertical
    // metrics of its own.
    let down = libharfbuzz.hb_font_get_glyph_v_advance(font, 1) as i32
    test.assert(down < 0)
    libharfbuzz.hb_font_destroy(font)
    ptr.free(glyph)
    ptr.free(font_bytes)

@test
fn test_a_font_answers_extents_and_glyph_names() [io, ffi]
    test.case("hb_font_get_glyph_extents, hb_font_get_h_extents, hb_font_get_glyph_name, hb_font_get_glyph_from_name")
    let font_bytes = font_buffer()
    let font = test_font(font_bytes)
    let extents = ptr.alloc(EXTENTS_SIZE)
    test.assert(libharfbuzz.hb_font_get_glyph_extents(font, 1, extents) == 1)
    // The square is 500 design units wide, doubled by the scale.
    test.assert(i32_at(extents + 8) == 1000)
    // The height is measured downwards from the top bearing, so it is
    // negative, and the top bearing is above the baseline.
    let height = i32_at(extents + 12)
    let top = i32_at(extents + 4)
    test.assert(height < 0)
    test.assert(top > 0)
    // The substitute glyph is empty and its box is four zeroes.
    test.assert(libharfbuzz.hb_font_get_glyph_extents(font, 0, extents) == 1)
    test.assert(i32_at(extents + 8) == 0)
    let font_extents = ptr.alloc(FONT_EXTENTS_SIZE)
    test.assert(libharfbuzz.hb_font_get_h_extents(font, font_extents) == 1)
    let ascender = i32_at(font_extents)
    let descender = i32_at(font_extents + 4)
    test.assert(ascender > 0)
    // The descender is negative, because it is below the baseline.
    test.assert(descender < 0)
    let name = ptr.alloc(64)
    test.assert(libharfbuzz.hb_font_get_glyph_name(font, 1, name, 64) == 1)
    test.assert(ptr.read_str(name) == "square")
    let glyph = ptr.alloc_word()
    test.assert(libharfbuzz.hb_font_get_glyph_from_name(font, "triangle", -1, glyph) == 1)
    test.assert(u32_at(glyph) == 2)
    // A name the font does not have answers 0.
    test.assert(libharfbuzz.hb_font_get_glyph_from_name(font, "nosuchglyph", -1, glyph) == 0)
    libharfbuzz.hb_font_destroy(font)
    ptr.free(glyph)
    ptr.free(name)
    ptr.free(font_extents)
    ptr.free(extents)
    ptr.free(font_bytes)

@test
fn test_a_buffer_guesses_the_properties_it_was_not_given() [io, ffi]
    test.case("hb_buffer_create, hb_buffer_add_utf8, hb_buffer_get_length, hb_buffer_guess_segment_properties, hb_buffer_get_direction, hb_buffer_get_script, hb_buffer_get_language, hb_buffer_destroy")
    let buffer = libharfbuzz.hb_buffer_create()
    test.assert(buffer != 0)
    // An empty buffer has no direction, script or language.
    test.assert(libharfbuzz.hb_buffer_get_direction(buffer) == DIRECTION_INVALID)
    test.assert(libharfbuzz.hb_buffer_get_script(buffer) == 0)
    test.assert(libharfbuzz.hb_buffer_get_language(buffer) == 0)
    libharfbuzz.hb_buffer_add_utf8(buffer, "AB", -1, 0, -1)
    // Before shaping the length is the number of characters.
    test.assert(libharfbuzz.hb_buffer_get_length(buffer) == 2)
    libharfbuzz.hb_buffer_guess_segment_properties(buffer)
    // Latin characters give the Latin script and left-to-right, and
    // the language comes from the process locale.
    test.assert(libharfbuzz.hb_buffer_get_script(buffer) == SCRIPT_LATIN)
    test.assert(libharfbuzz.hb_buffer_get_direction(buffer) == DIRECTION_LTR)
    test.assert(libharfbuzz.hb_buffer_get_language(buffer) != 0)
    libharfbuzz.hb_buffer_destroy(buffer)

@test
fn test_a_buffer_is_told_its_properties_and_emptied_two_ways() [io, ffi]
    test.case("hb_buffer_set_direction, hb_buffer_set_script, hb_buffer_set_language, hb_buffer_set_cluster_level, hb_buffer_get_cluster_level, hb_buffer_clear_contents, hb_buffer_reset, hb_buffer_add_codepoints")
    let buffer = libharfbuzz.hb_buffer_create()
    // Two code points already decoded, rather than UTF-8 bytes.
    let text = ptr.alloc(8)
    ptr.write_i32(text, 65)
    ptr.write_i32(text + 4, 66)
    libharfbuzz.hb_buffer_add_codepoints(buffer, text, 2, 0, -1)
    test.assert(libharfbuzz.hb_buffer_get_length(buffer) == 2)
    libharfbuzz.hb_buffer_set_direction(buffer, DIRECTION_RTL)
    libharfbuzz.hb_buffer_set_script(buffer, SCRIPT_LATIN)
    libharfbuzz.hb_buffer_set_language(buffer, libharfbuzz.hb_language_from_string("en", -1))
    // The default cluster level groups the cluster values by grapheme.
    test.assert(libharfbuzz.hb_buffer_get_cluster_level(buffer) == 0)
    libharfbuzz.hb_buffer_set_cluster_level(buffer, 1)
    test.assert(libharfbuzz.hb_buffer_get_cluster_level(buffer) == 1)
    // Clearing the contents takes the text's own properties with the
    // text, and leaves the cluster level alone.
    libharfbuzz.hb_buffer_clear_contents(buffer)
    test.assert(libharfbuzz.hb_buffer_get_length(buffer) == 0)
    test.assert(libharfbuzz.hb_buffer_get_direction(buffer) == DIRECTION_INVALID)
    test.assert(libharfbuzz.hb_buffer_get_script(buffer) == 0)
    test.assert(libharfbuzz.hb_buffer_get_language(buffer) == 0)
    test.assert(libharfbuzz.hb_buffer_get_cluster_level(buffer) == 1)
    // Resetting takes the cluster level as well.
    libharfbuzz.hb_buffer_reset(buffer)
    test.assert(libharfbuzz.hb_buffer_get_cluster_level(buffer) == 0)
    libharfbuzz.hb_buffer_destroy(buffer)
    ptr.free(text)

@test
fn test_two_characters_shape_into_two_glyphs_with_positions() [io, ffi]
    test.case("hb_shape, hb_buffer_get_glyph_infos, hb_buffer_get_glyph_positions, hb_buffer_has_positions, hb_buffer_reverse")
    let font_bytes = font_buffer()
    let font = test_font(font_bytes)
    let buffer = libharfbuzz.hb_buffer_create()
    libharfbuzz.hb_buffer_add_utf8(buffer, "AB", -1, 0, -1)
    libharfbuzz.hb_buffer_guess_segment_properties(buffer)
    // A buffer has no positions until it is shaped.
    test.assert(libharfbuzz.hb_buffer_has_positions(buffer) == 0)
    libharfbuzz.hb_shape(font, buffer, 0, 0)
    test.assert(libharfbuzz.hb_buffer_has_positions(buffer) == 1)
    let length = ptr.alloc_word()
    let infos = libharfbuzz.hb_buffer_get_glyph_infos(buffer, length)
    test.assert(u32_at(length) == 2)
    let positions = libharfbuzz.hb_buffer_get_glyph_positions(buffer, length)
    test.assert(u32_at(length) == 2)
    // The glyph index is the first four bytes of a twenty-byte record,
    // and the cluster is eight bytes in.
    test.assert(u32_at(infos) == 1)
    test.assert(u32_at(infos + 8) == 0)
    test.assert(u32_at(infos + GLYPH_RECORD) == 2)
    test.assert(u32_at(infos + GLYPH_RECORD + 8) == 1)
    // The x advance is the first four bytes of a position record, and
    // the three offsets after it are zero for an unkerned pair.
    test.assert(i32_at(positions) == ADVANCE * SCALE / UPEM)
    test.assert(i32_at(positions + 4) == 0)
    test.assert(i32_at(positions + 8) == 0)
    test.assert(i32_at(positions + 12) == 0)
    test.assert(i32_at(positions + GLYPH_RECORD) == ADVANCE * SCALE / UPEM)
    // Reversing puts the last glyph first.
    libharfbuzz.hb_buffer_reverse(buffer)
    test.assert(u32_at(libharfbuzz.hb_buffer_get_glyph_infos(buffer, length)) == 2)
    libharfbuzz.hb_buffer_destroy(buffer)
    libharfbuzz.hb_font_destroy(font)
    ptr.free(length)
    ptr.free(font_bytes)

@test
fn test_a_feature_is_read_from_text_and_written_back() [io, ffi]
    test.case("hb_feature_from_string, hb_feature_to_string, hb_shape_full, hb_shape_list_shapers")
    let feature = ptr.alloc(FEATURE_SIZE)
    test.assert(libharfbuzz.hb_feature_from_string("kern=0", -1, feature) == 1)
    test.assert(u32_at(feature) == libharfbuzz.hb_tag_from_string("kern", -1))
    test.assert(u32_at(feature + 4) == 0)
    // With no range the feature covers the whole run: 0 to the largest
    // unsigned 32-bit value.
    test.assert(u32_at(feature + 8) == 0)
    test.assert(u32_at(feature + 12) == 4294967295)
    let text = ptr.alloc(64)
    libharfbuzz.hb_feature_to_string(feature, text, 64)
    test.assert(ptr.read_str(text) == "-kern")
    // Text that is not a feature setting is refused.
    test.assert(libharfbuzz.hb_feature_from_string("not a feature!!", -1, feature) == 0)
    // Shaping with that one feature, and with the library's own
    // choice of shaper.
    let font_bytes = font_buffer()
    let font = test_font(font_bytes)
    let buffer = libharfbuzz.hb_buffer_create()
    libharfbuzz.hb_buffer_add_utf8(buffer, "AB", -1, 0, -1)
    libharfbuzz.hb_buffer_guess_segment_properties(buffer)
    let _ = libharfbuzz.hb_feature_from_string("kern=0", -1, feature)
    test.assert(libharfbuzz.hb_shape_full(font, buffer, feature, 1, 0) == 1)
    test.assert(libharfbuzz.hb_buffer_get_length(buffer) == 2)
    // The shapers this build has, as a null-terminated array of
    // addresses of strings.
    let shapers = libharfbuzz.hb_shape_list_shapers()
    test.assert(shapers != 0)
    test.assert(str.len(ptr.read_str(ptr.read_word(shapers))) > 0)
    libharfbuzz.hb_buffer_destroy(buffer)
    libharfbuzz.hb_font_destroy(font)
    ptr.free(font_bytes)
    ptr.free(text)
    ptr.free(feature)

@test
fn test_a_shaped_buffer_writes_itself_out_as_text() [io, ffi]
    test.case("hb_buffer_serialize_format_from_string, hb_buffer_serialize_glyphs")
    let font_bytes = font_buffer()
    let font = test_font(font_bytes)
    let buffer = libharfbuzz.hb_buffer_create()
    libharfbuzz.hb_buffer_add_utf8(buffer, "AB", -1, 0, -1)
    libharfbuzz.hb_buffer_guess_segment_properties(buffer)
    libharfbuzz.hb_shape(font, buffer, 0, 0)
    let format = libharfbuzz.hb_buffer_serialize_format_from_string("text", -1)
    test.assert(format != 0)
    // The name is only upper-cased and read as a tag, so a name the
    // library does not know is a tag that is not a format, and only an
    // empty name is a 0.
    test.assert(libharfbuzz.hb_buffer_serialize_format_from_string("yaml", -1) != format)
    test.assert(libharfbuzz.hb_buffer_serialize_format_from_string("", -1) == 0)
    let out = ptr.alloc(256)
    let used = ptr.alloc_word()
    let n = libharfbuzz.hb_buffer_serialize_glyphs(buffer, 0, 2, out, 256, used, font, format, 0)
    test.assert(n == 2)
    // The font names the glyphs, so the text carries their names.
    test.assert(bytes.to_str(ptr.read_bytes_n(out, u32_at(used)))
                == "[square=0+1400|triangle=1+1400]")
    libharfbuzz.hb_buffer_destroy(buffer)
    libharfbuzz.hb_font_destroy(font)
    ptr.free(used)
    ptr.free(out)
    ptr.free(font_bytes)

@test
fn test_a_face_is_asked_which_layout_tables_it_has() [io, ffi]
    test.case("hb_ot_layout_has_substitution, hb_ot_layout_has_positioning")
    let font_bytes = font_buffer()
    let blob = libharfbuzz.hb_blob_create(font_bytes, FONT_LEN, MEMORY_DUPLICATE, 0, 0)
    let face = libharfbuzz.hb_face_create(blob, 0)
    // The test font carries neither table, and both answers are 0
    // rather than a failure.
    test.assert(libharfbuzz.hb_ot_layout_has_substitution(face) == 0)
    test.assert(libharfbuzz.hb_ot_layout_has_positioning(face) == 0)
    libharfbuzz.hb_face_destroy(face)
    libharfbuzz.hb_blob_destroy(blob)
    ptr.free(font_bytes)
